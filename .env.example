# Server-only OpenAI key used by the interactive search preview.
OPENAI_API_KEY=

# Optional model override. The production default is gpt-5.6-luna.
OPENAI_DEMO_MODEL=gpt-5.6-luna

# Public Calendly event URL rendered only after the user chooses to book.
# Example format: https://calendly.com/your-team/discovery-call
CALENDLY_URL=
